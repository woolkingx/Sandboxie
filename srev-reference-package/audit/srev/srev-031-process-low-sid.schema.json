  "properties": {
    "audit_contract": {
      "type": "string",
      "description": "API: API_INJECT_COMPLETE | request: {\"caller\": \"SbieSvc only\", \"fields\": [{\"index\": 1, \"name\": \"process_id\", \"type\": \"HANDLE\"}, {\"index\": 2, \"name\": \"sandboxie_logon_sid\", \"type\": \"PSID\", \"nullable\": true, \"max_bytes\": \"SECURITY_MAX_SID_SIZE\"}, {\"index\": 3, \"name\": \"inject_error\", \"type\": \"ULONG\"}]}"
