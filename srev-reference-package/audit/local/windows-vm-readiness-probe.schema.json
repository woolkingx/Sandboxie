{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Windows VM Readiness Probe Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "host", "user", "ports", "ssh", "ready"],
  "properties": {
    "schema": {
      "const": "windows-vm-readiness-probe/v1"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "user": {
      "type": "string",
      "minLength": 1
    },
    "ports": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "required": ["22", "5985", "3389", "5986"]
    },
    "ssh": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/commandResult"
      }
    },
    "ready": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "command": {
      "type": ["array", "string"]
    }
  },
  "definitions": {
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "returncode", "stdout", "stderr"],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "returncode": {
          "type": "integer"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      }
    }
  }
}
